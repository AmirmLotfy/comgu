# --- DataHub ---
# Local development goes through the SSH tunnel to the GCE VM (port 18080).
# On the VM itself this is http://localhost:8080
DATAHUB_GMS_URL=http://localhost:18080
# Empty while METADATA_SERVICE_AUTH_ENABLED=false. Must be a real PAT before
# anything is exposed publicly.
DATAHUB_GMS_TOKEN=

# MCP server. Mutation tools are required for DataHub write-back.
TOOLS_IS_MUTATION_ENABLED=true
SAVE_DOCUMENT_TOOL_ENABLED=true

# --- Shopify (day 4) ---
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_WEBHOOK_SECRET=

# --- GitHub (day 10) ---
GITHUB_TOKEN=
GITHUB_LAB_REPO=

# --- AI planner (day 8) ---
COMGU_AI_PROVIDER=fake
VERTEX_PROJECT=goosecast
VERTEX_LOCATION=europe-west1
