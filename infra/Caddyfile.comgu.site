# Product. The sslip.io host stays listed so links already published in the
# submission keep working — a judge with the old URL must not hit a dead host.
app.comgu.site, app.35-240-72-53.sslip.io {
    encode gzip
    reverse_proxy 127.0.0.1:8000
}

# DataHub catalog. Basic auth sits in front of DataHub own login, which is
# datahub/datahub and not a credential to expose. GMS on :8080 is never proxied.
context.comgu.site, datahub.35-240-72-53.sslip.io {
    encode gzip
    basic_auth {
        judge $2a$14$iDxBvm8ydAlCz/c3QQ/2XugqRrM7Jfuf2C89EIAsSJoxktMYGAMWW
    }
    reverse_proxy 127.0.0.1:9002
}

# comgu.site and www.comgu.site are deliberately absent: they resolve to Vercel,
# so Caddy would fail their ACME challenges repeatedly and hit rate limits.
